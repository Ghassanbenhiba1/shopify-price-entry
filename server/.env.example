# Connexion à la base PostgreSQL.
# Sur Render/Supabase/Neon : DATABASE_URL suffit (fournie par l'hébergeur).
# En local sans DATABASE_URL, ces variables sont utilisées à la place :
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Port d'écoute du serveur Node en local. Sur Render, le port est imposé
# automatiquement via la variable PORT.
PORT=3001

# Origine(s) autorisée(s) à appeler l'API (le domaine où est hébergé le frontend).
# Plusieurs origines séparées par une virgule. "*" autorise tout le monde.
CORS_ORIGIN=http://localhost:5173
