# URL de base de l'API backend (Node.js + Express + MySQL), sans slash final.
# En développement local : l'adresse du serveur lancé depuis server/ (voir server/.env.example).
# En production : l'URL de l'app Node.js créée dans cPanel (o2switch), ex. un sous-domaine dédié.
#
# Si cette variable est vide, l'application reste utilisable mais uniquement
# via un fichier CSV importé manuellement (pas de catalogue ni de prix partagés).
VITE_API_BASE_URL=http://localhost:3001
